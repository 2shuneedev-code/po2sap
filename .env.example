# ═══════════════════════════════════════════════════════════════
#  환경 전환의 단일 창구. 이 파일을 .env 로 복사해서 쓴다.
#  **코드는 환경마다 같다. 다른 것은 이 파일뿐이다.**
#  .env 는 절대 커밋하지 않는다.
# ═══════════════════════════════════════════════════════════════

# ── LLM (Claude API) ───────────────────────────────────────────
# mock       저장된 응답 재생. 키 없이·비용 0·오프라인 (개발 · CI)
# anthropic  Claude API 직접 호출  → LLM_BASE_URL 비움
# gateway    사내 LLM 게이트웨이   → LLM_BASE_URL 에 사내 주소
#            (Anthropic 호환 엔드포인트 전제. 코드는 같고 주소만 다르다)
LLM_PROVIDER=mock
LLM_API_KEY=

# 비우면 Claude API 기본 주소(https://api.anthropic.com).
# 사내 게이트웨이면 그 주소를 넣는다. 끝에 /v1 을 붙이지 않는다 — SDK 가 붙인다.
#   예) https://llm-gw.yg1.solutions
LLM_BASE_URL=

# 역할 별칭 → 실제 모델 ID. 사내 계정이 쓸 수 있는 모델로 맞춘다.
# 모델을 바꾸면 추출 정확도가 달라지므로 골든 테스트를 전량 다시 돌린다.
LLM_MODEL_EXTRACT=claude-opus-5
LLM_MODEL_FALLBACK=claude-sonnet-5
LLM_MAX_TOKENS=16000
# **호출 1회(청크 1개) 기준** 타임아웃이다. 문서 1건은 골격 1회 + 품목 N회로 나뉘어
# 불리므로 문서 전체의 상한은 LLM_DOC_BUDGET_SEC 가 따로 건다.
LLM_TIMEOUT_SEC=120
LLM_MAX_CONCURRENCY=4

# 큰 문서를 청크로 나눠 읽을 때의 재시도·분할 손잡이 (design.md §3.3.4).
# LLM_MAX_RETRIES        SDK 가 호출 1회 안에서 하는 재시도 (429·5xx·타임아웃)
# LLM_CHUNK_RETRIES      그래도 실패한 청크를 다시 부르는 횟수 (5xx·타임아웃만)
# LLM_CHUNK_SPLIT_DEPTH  출력이 max_tokens 에서 잘린 청크를 절반으로 쪼개 다시 부를 수 있는 단계 수
# LLM_DOC_BUDGET_SEC     문서 1건의 LLM 작업 전체 상한(초). 넘으면 남은 청크를 취소하고
#                        읽지 못한 구간을 🔴 로 표시한다 (부분 결과는 살린다)
# PARSE_STALE_SEC        PARSING 상태로 이만큼(초) 지난 배치는 서버가 죽은 것으로 보고
#                        조회 결과에서만 FAILED 로 보인다 (디스크는 고치지 않는다)
LLM_MAX_RETRIES=2
LLM_CHUNK_RETRIES=1
LLM_CHUNK_SPLIT_DEPTH=2
LLM_DOC_BUDGET_SEC=900
PARSE_STALE_SEC=1800

# 추출 스키마(schema_builder)나 SYSTEM_PROMPT 를 고치면 올린다.
# 안 올리면 구 스키마로 받은 캐시가 그대로 재생돼 값이 조용히 빈다.
LLM_PROMPT_VERSION=v3

# 추론 깊이 — **출력 토큰(=비용)을 가장 크게 좌우한다.**
# 2026-09-21 실측: 발주서 1부 출력 62,588 토큰 = 비용의 65%.
# low 가 가장 싸다. 품질이 안 나오면 한 칸씩 올리며 측정한다.
LLM_EFFORT=medium                  # low | medium | high | xhigh | max

# 사내 프록시 / SSL 검사 장비
# ★ 여기 적어야 실제로 전달된다. 셸의 HTTPS_PROXY 환경변수나 이 파일의
#   HTTPS_PROXY 는 HTTP 클라이언트에 도달하지 않는다 (.env 는 Settings 로만 읽힌다).
LLM_PROXY=                         # 예: http://proxy.사내:8080
LLM_CA_BUNDLE=                     # 사내 CA 인증서(.pem) 경로. 없으면 시작 시 오류

# ── 마스터 편집 잠금 ───────────────────────────────────────────
# 브랜드 매핑 화면의 저장은 **서버 디스크의 masters/refs/brand_keys.csv 를
# 고친다.** 그 서버를 보는 모두의 판정이 즉시 함께 바뀐다.
# 이 암호를 아는 사람만 고칠 수 있다 (조회는 누구나).
#
# **비어 있으면 편집이 잠긴다.** EAI_ENDPOINT 와 같은 원칙 — .env 를 깜빡한 채
# 띄웠을 때 열려 있는 것보다 잠겨 있는 편이 안전하다.
# 바꾸면 화면을 다시 시작해야 반영된다.
MASTER_EDIT_PASSWORD=

# 저장할 때마다 그 CSV 를 자동으로 커밋·푸시한다.
# 켜 두면 원격이 늘 서버와 같아서 **다음 git pull 이 현업 값을 건드리지 않는다.**
# 서버에 Git 자격증명(PAT/SSH 키)이 있어야 하고, 없으면 꺼 둔 채
# 화면의 "Git 동기화"에서 눌러서 확인하며 하면 된다.
MASTER_GIT_AUTOPUSH=false

# 덮어쓰기 전 사본을 몇 개까지 남길지 (storage/master_backups/). 0 이하면 무제한.
# 자동 푸시와 무관하게 **항상** 남는다 — 네트워크도 계정도 필요 없다.
MASTER_BACKUP_KEEP=30

# ── EAI 전송 ───────────────────────────────────────────────────
# 개발    https://eai-dev.yg1.solutions:5443/po2sap/order
# 운영    https://eai-prd.yg1.solutions:5443/po2sap/order   ← 이관 시 이 줄만 바꾼다
# 모의 서버  http://127.0.0.1:9000/po2sap/order  (python scripts/mock_eai_server.py)
#
# **HTTPS 가 아니면 전송이 거부된다.** 평문 http 는 루프백에서만 허용한다.
# 기본값은 비어 있다 — .env 를 깜빡한 채 진짜 오더가 나가는 일을 막는다.
EAI_ENDPOINT=http://127.0.0.1:9000/po2sap/order

EAI_AUTH_MODE=none                 # none | apikey | basic
EAI_API_KEY=
EAI_API_KEY_HEADER=X-API-Key
EAI_BASIC_USER=
EAI_BASIC_PASSWORD=

EAI_TIMEOUT_SEC=60
EAI_RETRIES=3                      # 5xx·타임아웃만 재시도. 4xx 는 즉시 실패
EAI_MAX_ROWS_PER_REQUEST=0         # 0 = 무제한
EAI_VERIFY_TLS=true                # 끄지 않는다. 사내 CA 는 아래로 지정
EAI_CA_BUNDLE=

# rows  → {"rows": [ {...}, ... ]}
# array → [ {...}, ... ]
PAYLOAD_ROOT=rows
