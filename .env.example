# ─────────────────────────────────────────────────────────
# PO2SAP 환경 설정  (.env.example → .env 로 복사해서 사용)
# 환경 전환(개발 PC → 사내 서버)은 이 파일만 교체한다.
# ─────────────────────────────────────────────────────────

# ── LLM 프로바이더 ───────────────────────────────────────
# mock             : API 호출 없이 저장된 골든 응답 재생 (키 불필요, 비용 0)
# anthropic        : Anthropic API 직접 호출
# gateway          : 사내 LLM 게이트웨이 (LLM_BASE_URL 지정)
LLM_PROVIDER=mock

LLM_API_KEY=
LLM_BASE_URL=

# 역할 별칭 → 실제 모델 ID (프로바이더가 바뀌면 이 값만 교체)
LLM_MODEL_EXTRACT=claude-sonnet-4-5
LLM_MODEL_FALLBACK=claude-opus-4-1

LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SEC=120
LLM_MAX_CONCURRENCY=4
LLM_PROMPT_VERSION=v1

# ── 네트워크 (사내 서버 이관 시) ─────────────────────────
# HTTPS_PROXY=http://proxy.corp.local:8080
# NO_PROXY=localhost,127.0.0.1,eai.corp.local
# REQUESTS_CA_BUNDLE=/etc/ssl/corp-ca.pem

# ── EAI 전송 ─────────────────────────────────────────────
EAI_ENDPOINT=http://127.0.0.1:9000/api/po2sap/salesorder
EAI_AUTH_MODE=none
EAI_TIMEOUT_SEC=60
PAYLOAD_ROOT=rows

# ── 경로 ─────────────────────────────────────────────────
MASTERS_DIR=./masters
STORAGE_DIR=./storage
