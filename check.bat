@echo off
rem ============================================================
rem   po2sap - 설정 점검
rem   LLM 을 호출하지 않으므로 비용이 들지 않습니다.
rem ============================================================
setlocal
cd /d "%~dp0"

if not exist ".venv\Scripts\python.exe" (
    echo [오류] 가상환경이 없습니다. setup.bat 을 먼저 실행하세요.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   1. Claude API 연결   ^(메시지 전송 없음 = 비용 0^)
echo ============================================================
.venv\Scripts\python.exe scripts\check_llm.py

echo.
echo ============================================================
echo   2. 마스터 규칙 검증
echo ============================================================
.venv\Scripts\python.exe scripts\validate_masters.py --quiet
if errorlevel 1 (
    echo.
    echo [주의] 마스터에 오류가 있습니다. 위 내용을 확인하세요.
) else (
    echo 오류 없음.
)

echo.
echo ============================================================
echo   점검이 끝났습니다.
echo ============================================================
echo.
pause
